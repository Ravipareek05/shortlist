# Copy to server/.env and fill in real values. Never commit server/.env.

# Runtime
NODE_ENV=development
PORT=5000

# Comma-separated list of allowed browser origins (your frontend URLs)
CLIENT_URLS=http://localhost:5173

# Recruiter JWT signing secret: use a long random string (at least 32 characters)
# e.g. node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret

# MongoDB Atlas connection string (with or without query options)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Database name (existing data lives in "job-portal")
MONGODB_DB=job-portal

# Cloudinary
CLOUDINARY_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_SECRET_KEY=your-api-secret

# Clerk
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx

# Sentry (optional: leave empty to disable)
SENTRY_DSN=
