# Copy to client/.env and fill in real values. Never commit client/.env.
# Only public values belong here: everything prefixed VITE_ is bundled into the browser.

VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx
VITE_BACKEND_URL=http://localhost:5000
# Public URL of the deployed frontend (used for canonical/OG tags)
VITE_SITE_URL=http://localhost:5173
